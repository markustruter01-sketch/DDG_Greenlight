# Names only. Values live in Replit secrets (production) or GitHub Actions secrets (recording runs).

# Server
PORT=
HOST=
BASE_PATH=
LOG_LEVEL=
DATABASE_URL=
PRIVATE_OBJECT_DIR=

# Sign-in (Clerk)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Reading repositories
GITHUB_TOKEN=

# Fix it with Claude (the only place a model is called)
ANTHROPIC_API_KEY=
GREENLIGHT_FIX_MODEL=claude-sonnet-4-6
GREENLIGHT_FIX_MAX_TURNS=40
GREENLIGHT_FIX_BUDGET_USD=5
# Optional: folder to append one .events.jsonl per fix run (recordings)
GREENLIGHT_RECORD_DIR=
# Set to 1 to let the UI open links to the real GitHub repositories. Unset (demo) shows a notice instead.
GREENLIGHT_EXTERNAL_LINKS=
